          <string name="Name">Request</string>
          <string name="Source">local RequestType = require(script.Parent.RequestType)

export type Request = {
    UUID: string,
    RequestFunctionID: string,
    RequestType: RequestType.RequestType
}

local module = {}

return module;</string>
